{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tm-designs/measure-core": [
        "./packages/measure-core/src/index.ts"
      ],
      "@tm-designs/measure-core/*": [
        "./packages/measure-core/src/*"
      ],
      "@tm-designs/capacitor-roomplan": [
        "./packages/capacitor-roomplan/src/index.ts"
      ],
      "@tm-designs/capacitor-roomplan/*": [
        "./packages/capacitor-roomplan/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "mobile",
    "ios",
    "android"
  ],
  "extends": "expo/tsconfig.base"
}
