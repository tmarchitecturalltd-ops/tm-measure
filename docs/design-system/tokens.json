{
  "$comment": "Authoritative Industrial tokens. Source of truth is :root in app/globals.css; this mirrors it for programmatic use. Update both together and log it in docs/design-system/CHANGELOG.md.",
  "version": "2026-10-25",
  "color": {
    "chassis": "#cbd0d2",
    "raised": "#e7eaeb",
    "well": "#b6bec2",
    "ink": "#181e22",
    "label": "#414b52",
    "field": "#20272b",
    "onField": "#f2f4f4",
    "onFieldMuted": "#d8dee1",
    "accent": "#f15b22",
    "accentGlyph": "#8f300d",
    "accentOnDark": "#ff8a5c",
    "accentHover": "#d44d18",
    "error": "#b3261e"
  },
  "semantic": {
    "bg-surface": "#cbd0d2",
    "bg-surface-container-lowest": "#eef1f2",
    "bg-surface-container-low": "#e7eaeb",
    "bg-surface-container": "#dde1e3",
    "bg-surface-container-high": "#d3d8da",
    "bg-surface-container-highest": "#c3cacd",
    "bg-surface-dim": "#b6bec2",
    "bg-inverse-surface": "#20272b",
    "text-on-surface": "#181e22",
    "text-on-surface-variant": "#414b52",
    "text-inverse-on-surface": "#f2f4f4",
    "border-outline": "#8d979d",
    "border-outline-variant": "#a8b1b6",
    "bg-primary": "#f15b22",
    "text-on-primary": "#181e22",
    "text-primary": "#8f300d"
  },
  "typography": {
    "sans": "\"Industrial Host\", sans-serif",
    "mono": "\"Industrial Plex\", monospace",
    "resolvesTo": { "sans": "Host Grotesk", "mono": "IBM Plex Mono" },
    "body": "17px",
    "reading": "16px",
    "metadata": "13px",
    "label": "11px",
    "minimumBody": "14px"
  },
  "spacing": { "columnGap": "25px", "compactGap": "12px" },
  "radius": { "key": "4px", "case": "10px", "circular": "50%" },
  "border": { "hairline": "1px" },
  "motion": {
    "navigation": "130ms",
    "key": "140ms",
    "dial": "150ms",
    "settle": "cubic-bezier(0.3, 0.7, 0.4, 1.25)"
  },
  "contrast": {
    "normalText": 4.5,
    "largeText": 3.0,
    "notes": "White on accent is 3.3:1 and is forbidden. Ink on accent is 5.0:1. Accent as glyph on raised is 3.0:1, hence accentGlyph."
  },
  "targets": { "minimumTapPx": 44 }
}
