<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules.

  We exclude everything from both cloud backup and device-to-device
  transfer, because the app's localStorage holds the architect endpoint
  URL, the customer's auto-saved project draft (name, email, project
  details), and per-device camera calibration — none of which we want
  copied off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
