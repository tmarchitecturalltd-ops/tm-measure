<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>TM Measure</string>
	<key>NSCameraUsageDescription</key>
	<string>TM Measure uses the camera to scan room dimensions during the auto-scan flow. Scan imagery is processed on your device and is not uploaded.</string>
	<key>NSMotionUsageDescription</key>
	<string>TM Measure reads the angle your phone is held at while you tap room corners. Without it, distances cannot be calculated.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TM Measure uses your microphone to record voice notes when measuring rooms.</string>
	<!-- Export compliance, declared once here instead of by hand on every
	     upload. App Store Connect asks the encryption question per BUILD,
	     not per app, so without this it appears on every single upload and
	     blocks the build from reaching testers until someone answers it —
	     usually noticed late, when the build is already needed.

	     False is the correct answer: the app implements no encryption of
	     its own. It talks HTTPS to the submission endpoint, which is the
	     operating system's own encryption, and that is exempt. There are
	     no crypto libraries in the project; the only `crypto` call in the
	     codebase is randomUUID, which generates identifiers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Allow TM Measure to save scan reference photos to your device.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TM Measure lets you attach photos from your library as reference shots for each room you measure.</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
