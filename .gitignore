# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Static export for Capacitor (`npm run build:cap`)
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!mobile/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local PRD / stitch extraction artifacts
/_prd_extract/
/_stitch_extract/
/_prd.zip
/_prd_text.txt
