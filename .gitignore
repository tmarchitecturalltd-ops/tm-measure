# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Static export for Capacitor (`npm run build:cap`)
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!mobile/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local PRD / stitch extraction artifacts
/_prd_extract/
/_stitch_extract/
/_prd.zip
/_prd_text.txt

certificates

# Signing material. The upload keystore is the only thing that can sign
# an update to the Play listing: publishing it means losing control of
# the app, and it cannot be rotated without Google's involvement. These
# were previously untracked but not ignored — one `git add -A` from
# being pushed to a public remote.
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
gcloud-service-account*.json

# Build artifacts — large, rebuildable, and .aab/.apk bundles embed the
# runtime config they were built with.
*.aab
*.apk
*.apks
*.ipa
